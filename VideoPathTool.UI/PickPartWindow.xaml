<Window x:Class="VideoPathTool.UI.PickPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要解析的分P" Height="560" Width="760"
        MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12">

    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top" x:Name="TxtHeader" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <TextBlock x:Name="TxtHint" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="11" Foreground="{StaticResource Muted}"
                       Text="双击一行可直接确认" />
            <Button Content="取消" IsCancel="True" Click="OnCancelClick" />
            <Button Content="确定" IsDefault="True" Click="OnOkClick"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>

        <DataGrid x:Name="PartGrid" IsReadOnly="True" SelectionMode="Single"
                  MouseDoubleClick="OnGridDoubleClick"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="P" Binding="{Binding PageLabel}" Width="60" />
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
