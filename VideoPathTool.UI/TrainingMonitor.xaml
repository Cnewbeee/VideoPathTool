<UserControl x:Class="VideoPathTool.UI.TrainingMonitor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12">

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 第一行：看哪一次训练 ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="运行目录" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                <ComboBox x:Name="CboRun" Grid.Column="1" VerticalContentAlignment="Center"
                          SelectionChanged="OnRunChanged"
                          ToolTip="列出 video/output/yolo 下所有带 results.csv 或 progress.json 的运行" />
                <CheckBox x:Name="ChkAuto" Grid.Column="2" Content="自动刷新" IsChecked="True"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button x:Name="BtnRefresh" Grid.Column="3" Content="刷新" Click="OnRefreshClick"
                        MinWidth="0" Margin="8,0,0,0"
                        ToolTip="立刻重新读取目录与进度（F5）" />
                <Button x:Name="BtnBrowse" Grid.Column="4" Content="…" Click="OnBrowseClick"
                        MinWidth="28" Margin="6,0,0,0" ToolTip="手动挑一个训练输出目录" />
            </Grid>
        </Border>

        <!-- ================= 第二行：总进度 + 关键数字 ================= -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtState" DockPanel.Dock="Left" Text="未选择训练"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtRunHint" DockPanel.Dock="Right" FontSize="11"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <ProgressBar x:Name="BarEpochs" Height="10" Minimum="0" Maximum="1" Value="0" />
                <TextBlock x:Name="TxtEpochBar" Text="—" FontSize="11"
                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" />

                <ProgressBar x:Name="BarBatch" Height="5" Minimum="0" Maximum="1" Value="0"
                             Margin="0,8,0,0" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="TxtBatchBar" Text="—" FontSize="11"
                           Foreground="{StaticResource Muted}" Margin="0,4,0,0" />

                <UniformGrid Columns="6" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="轮次" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatEpoch" Text="—" Style="{StaticResource StatValue}" FontSize="14" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="速度" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatSpeed" Text="—" Style="{StaticResource StatValue}" FontSize="14" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="每轮" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatPerEpoch" Text="—" Style="{StaticResource StatValue}" FontSize="14" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="已用" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatElapsed" Text="—" Style="{StaticResource StatValue}" FontSize="14" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="剩余" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatEta" Text="—" Style="{StaticResource StatValue}" FontSize="14" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="最优 mAP50" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatBest" Text="—" Style="{StaticResource StatValue}" FontSize="14" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ================= 第三行：曲线 ================= -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="4" Padding="10,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="损失（每轮均值）"
                               Style="{StaticResource SectionHeader}" />
                    <Canvas x:Name="LossChart" Height="170" ClipToBounds="True"
                            SizeChanged="OnChartSizeChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="4" Padding="10,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="验证指标"
                               Style="{StaticResource SectionHeader}" />
                    <Canvas x:Name="MetricChart" Height="170" ClipToBounds="True"
                            SizeChanged="OnChartSizeChanged" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= 第四行：每轮明细 ================= -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,0,8">
            <DataGrid x:Name="GridEpochs" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="Transparent" RowHeaderWidth="0"
                      CanUserSortColumns="True" EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="轮" Width="52" IsReadOnly="True"
                                        Binding="{Binding Epoch}" />
                    <DataGridTextColumn Header="box" Width="70" IsReadOnly="True"
                                        Binding="{Binding BoxLoss, StringFormat={}{0:F4}}" />
                    <DataGridTextColumn Header="cls" Width="70" IsReadOnly="True"
                                        Binding="{Binding ClsLoss, StringFormat={}{0:F4}}" />
                    <DataGridTextColumn Header="dfl" Width="70" IsReadOnly="True"
                                        Binding="{Binding DflLoss, StringFormat={}{0:F4}}" />
                    <DataGridTextColumn Header="P" Width="70" IsReadOnly="True"
                                        Binding="{Binding Precision, StringFormat={}{0:F3}}" />
                    <DataGridTextColumn Header="R" Width="70" IsReadOnly="True"
                                        Binding="{Binding Recall, StringFormat={}{0:F3}}" />
                    <DataGridTextColumn Header="mAP50" Width="76" IsReadOnly="True"
                                        Binding="{Binding Map50, StringFormat={}{0:F3}}" />
                    <DataGridTextColumn Header="mAP50-95" Width="86" IsReadOnly="True"
                                        Binding="{Binding Map5095, StringFormat={}{0:F3}}" />
                    <DataGridTextColumn Header="用时(s)" Width="*" IsReadOnly="True"
                                        Binding="{Binding EpochTime, StringFormat={}{0:F1}}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================= 第五行：从这里发起 / 观察一次训练 ================= -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="4" Padding="12,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="重新训练" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" Margin="0,0,8,0"
                               ToolTip="调训练脚本用的；结果写到 video/output/yolo/&lt;名称&gt;" />
                    <TextBox x:Name="TxtName" DockPanel.Dock="Left" Width="140"
                             VerticalContentAlignment="Center" Text="glider_v11" />
                    <TextBlock DockPanel.Dock="Left" Text="轮数" VerticalAlignment="Center"
                               Margin="10,0,6,0" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="TxtEpochs" DockPanel.Dock="Left" Width="56"
                             VerticalContentAlignment="Center" Text="120" />
                    <TextBlock DockPanel.Dock="Left" Text="batch" VerticalAlignment="Center"
                               Margin="10,0,6,0" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="TxtBatch" DockPanel.Dock="Left" Width="46"
                             VerticalContentAlignment="Center" Text="12" />
                    <Button x:Name="BtnTrain" DockPanel.Dock="Left" Content="▶ 开始训练"
                            Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                            Click="OnTrainClick" />
                    <Button x:Name="BtnStopTrain" DockPanel.Dock="Left" Content="⏹ 停止"
                            Margin="6,0,0,0" Click="OnStopTrainClick" IsEnabled="False" />
                    <Button x:Name="BtnToggleLog" DockPanel.Dock="Right" Content="输出 ▾"
                            MinWidth="0" Click="OnToggleLogClick" />
                </DockPanel>

                <TextBox x:Name="TxtLog" Visibility="Collapsed" Height="130" Margin="0,8,0,0"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="11" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
